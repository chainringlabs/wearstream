# WearStream settings: copy this file, then pass it to the container as its environment file
# (`env_file:` in Compose, `env_file:` in Ansible). Every setting below is optional and shows its
# default; uncomment a line to change it. Values are unquoted: Docker keeps quotes literally.
#
# Credentials never go in this file. They are files under /secrets: /secrets/whoop/client_id and
# client_secret, and optionally /secrets/garmin/email and password. The full reference is
# docs/intent/operator/operator-design.md; `wearstream config` shows the effective values.

# Sources: whoop, garmin, or both (required)
WEARSTREAM_SOURCES=whoop,garmin

# Schedules, windows and time limits (time limits in minutes, backfill pauses in seconds)
# WEARSTREAM_WHOOP_SCHEDULE=17 * * * *
# WEARSTREAM_WHOOP_RANGE_WINDOW_DAYS=8
# WEARSTREAM_WHOOP_RANGE_TIME_LIMIT=5
# WEARSTREAM_WHOOP_SNAPSHOTS_TIME_LIMIT=5
# WEARSTREAM_WHOOP_RANGE_BACKFILL_PAUSE=60
# WEARSTREAM_WHOOP_CHECKS_SCHEDULE=37 * * * *
# WEARSTREAM_WHOOP_CHECKS_TIME_LIMIT=10
# WEARSTREAM_GARMIN_DAILY_SCHEDULE=30 5 * * *
# WEARSTREAM_GARMIN_REFERENCE_SCHEDULE=30 5 * * *
# WEARSTREAM_GARMIN_DAILY_WINDOW_DAYS=14
# WEARSTREAM_GARMIN_DAILY_TIME_LIMIT=15
# WEARSTREAM_GARMIN_REFERENCE_TIME_LIMIT=10
# WEARSTREAM_GARMIN_DAILY_BACKFILL_PAUSE=60
# WEARSTREAM_GARMIN_CHECKS_SCHEDULE=7 3-21/6 * * *
# WEARSTREAM_GARMIN_CHECKS_TIME_LIMIT=10

# Whoop
# WEARSTREAM_WHOOP_BACKFILL_FROM=
# WEARSTREAM_WHOOP_REDIRECT_URI=http://localhost:8000/callback
# WEARSTREAM_WHOOP_REQUESTS_PER_MINUTE=60

# Garmin (SELECT, EXCLUDE and EXPECTED_EMPTY take comma-separated collection names;
# EXPECTED_EMPTY left empty means the built-in list, and none means an empty list)
# WEARSTREAM_GARMIN_BACKFILL_FROM=
# WEARSTREAM_GARMIN_CHINA=false
# WEARSTREAM_GARMIN_SELECT=
# WEARSTREAM_GARMIN_EXCLUDE=
# WEARSTREAM_GARMIN_ALT_FORMATS=false
# WEARSTREAM_GARMIN_PACING=2
# WEARSTREAM_GARMIN_EXPECTED_EMPTY=
# WEARSTREAM_GARMIN_LIBRARY_DEBUG=false

# General
# WEARSTREAM_LOG_FORMAT=console
# WEARSTREAM_LOG_LEVEL=INFO
# WEARSTREAM_FAILING_TICKS=3
# WEARSTREAM_UMASK=022
